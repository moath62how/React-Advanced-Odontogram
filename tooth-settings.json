{
  "schemaVersion": "1.0.0",
  "numberingSystem": "FDI",
  "teeth": {
    "permanent": [
      18, 17, 16, 15, 14, 13, 12, 11,
      21, 22, 23, 24, 25, 26, 27, 28,
      48, 47, 46, 45, 44, 43, 42, 41,
      31, 32, 33, 34, 35, 36, 37, 38
    ],
    "primary": [
      55, 54, 53, 52, 51,
      61, 62, 63, 64, 65,
      85, 84, 83, 82, 81,
      71, 72, 73, 74, 75
    ]
  },
  "settings": {
    "toothSelection": {
      "type": "enum",
      "options": ["none", "tooth-base", "milktooth", "implant", "tooth-under-gum"]
    },
    "toothSubstrate": {
      "type": "enum",
      "options": ["natural", "radix", "broken", "crownprep"]
    },
    "caries": {
      "type": "surfaceSet",
      "options": [
        "caries-subcrown",
        "caries-buccal",
        "caries-lingual",
        "caries-mesial",
        "caries-distal",
        "caries-occlusal"
      ]
    },
    "cariesSeverity": {
      "type": "surfaceMap",
      "surfaces": ["buccal", "lingual", "mesial", "distal", "occlusal"],
      "values": [0, 1, 2, 3, 4, 5, 6]
    },
    "rootCaries": {
      "type": "enum",
      "options": ["none", "active", "arrested", "active-cavitated"]
    },
    "restoration": {
      "type": "object",
      "fields": ["restorationType", "restorationMaterial", "fillingSurfaceMaterials", "fissureSealing", "fillingDefect"]
    },
    "pulpAndApicalDiagnosis": {
      "type": "object",
      "fields": ["endo", "pulpDx", "pulpLatin", "apicalDx", "periapicalType", "resorptionType", "endoResection"]
    },
    "endodonticTreatment": {
      "type": "object",
      "fields": [
        "treatmentStatus",
        "treatmentType",
        "sessions",
        "canals",
        "obturationStatus",
        "finalRestoration",
        "notes"
      ],
      "treatmentStatus": {
        "type": "enum",
        "options": ["planned", "in-progress", "completed", "interrupted"]
      },
      "treatmentType": {
        "type": "enum",
        "options": ["initial-root-canal", "retreatment"]
      },
      "canals": {
        "type": "array",
        "itemFields": [
          "canalName",
          "rootName",
          "workingLengthMm",
          "referencePoint",
          "measurementMethod",
          "finalFileSize",
          "taper",
          "obturationMaterial",
          "notes"
        ],
        "measurementMethod": {
          "type": "enum",
          "options": ["apex-locator", "radiograph", "combined", "other"]
        }
      },
      "obturationStatus": {
        "type": "enum",
        "options": ["not-started", "partially-completed", "completed"]
      },
      "finalRestoration": {
        "type": "enum",
        "options": ["pending", "temporary", "permanent-filling", "crown", "other"]
      }
    },
    "orthodontics": {
      "type": "object",
      "fields": ["orthoAppliance", "orthoDrift", "orthoVertical", "orthoRotation"]
    },
    "toothDetails": {
      "type": "object",
      "fields": [
        "prosthesis",
        "mobility",
        "wearEdge",
        "wearCervical",
        "discoloration",
        "brokenMesial",
        "brokenIncisal",
        "brokenDistal",
        "contactMesial",
        "contactDistal",
        "extractionWound",
        "extractionPlan",
        "missingClosed",
        "bridgePillar",
        "crownLeakage",
        "crownReplace",
        "crownNeeded",
        "parapulpalPin"
      ]
    },
    "periodontalFindings": {
      "type": "object",
      "fields": [
        "calculus",
        "mods",
        "periImplant",
        "cejVisibility",
        "rootConcavity",
        "gingivalThickness",
        "millerClass",
        "perio"
      ]
    },
    "diagnoses": {
      "type": "map",
      "field": "dxOverrides"
    },
    "notesAndExtensions": {
      "type": "object",
      "fields": ["note", "customStates"]
    }
  },
  "availability": {
    "sharedByAllTeeth": true,
    "surfaces": ["buccal", "lingual", "mesial", "distal", "occlusal"],
    "conditionalFields": {
      "periImplant": "implant teeth",
      "perio": "periodontal charting data",
      "cariesSeverity": "surface-specific; supported values are 0 through 6"
    }
  }
}
